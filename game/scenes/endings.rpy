label ending_router:

    if changed_style and respect >=3:
        jump ending_perfect_answer
    elif not changed_style and respect >= 2:
        jump ending_imperfect_but_real
    else:
        jump ending_balanced

label ending_perfect_answer:

    scene bg classroom
    with fade

    narrator "Pre-board results."
    narrator "The list goes up at 8:47 AM."
    narrator "Same time as always."

    narrator "Rank 1."
    narrator "Your name."
    narrator "First."

    narrator "You stand there and wait for it to feel like something."

    narrator "It doesn't."

    scene bg school_corridor at bg_fit
    with dissolve

    narrator "He finds you in the corridor."
    narrator "He always finds you."
    narrator "You've stopped wondering how."

    orion "Rank 1."

    mc "Rank 1."

    orion "How does it feel?"

    narrator "You open your mouth."
    narrator "The automatic answer is ready."
    narrator "Great.. great."
    narrator "Like it was supposed to."

    narrator "You close your mouth."

    mc "..."

    mc "Empty."

    orion "You wrote every step correctly."
    orion "Perfect significant figures."
    orion "Perfect dimensional analysis."
    orion "Perfect presentation."

    mc "Yes."

    orion "Was any of it yours?"

    narrator "The corridor."
    narrator "Empty."
    narrator "Fluorescent lights."

    mc "I don't know anymore."

    narrator "He sits down on the floor of the corridor."
    narrator "Back against the wall."
    narrator "Like it's the most normal thing."

    narrator "You look at him."
    narrator "Then you sit down too."

    orion "Tell me something you actually think."
    orion "Now what gets marked."
    orion "Not what sounds right."
    orion "Something real."

    narrator "You sit there for a long time."

    mc "I think I've been studying for other people for so long that I don't know what studying for myself looks like."

    orion "That's real."

    mc "It doesn't feel like enough."

    orion "It's a start."

    narrator "You sit on the floor of the corridor."
    narrator "Rank 1."
    narrator "The thing you've wanted since you were eleven years old."
    narrator "Sitting next to the person who held it before you."
    narrator "And neither of you is talking about the rank anymore."

    scene bg library
    with dissolve

    narrator "A week later."
    narrator "Library table."
    narrator "His notes, your questions."
    narrator "Same as always."

    narrator "Except this time you open the right side of your notebook."
    narrator "And you turn it toward him."

    orion "..."

    narrator "He reads it."
    narrator "All of it."
    narrator "Every observation."
    narrator "Every pattern."
    narrator "Every line you wrote about him in the margins."

    narrator "He doesn't say anything for a long time."

    orion "You've been doing this since the beginning."

    mc "Yes."

    orion "With everyone?"

    mc "Yes."

    orion "Why are you showing me?"

    mc "Because I'm tired of it being a secret."
    mc "Because you're the only person it would be dishonest to hide it from."

    narrator "He looks at the notebook."
    narrator "Then at you."

    orion "He smiles more after correcting someone."

    mc "What?"

    orion "That's what you wrote."
    orion "First entry."
    orion "About me."

    mc "..."

    orion "You were right."
    orion "I do."

    narrator "He closes the notebook."
    narrator "He slides it back."

    orion "I kept one too."

    mc "What?"

    narrator "He opens his own notebook."
    narrator "The margin."
    narrator "The one you've been trying to read for months."

    narrator "You read it."

    narrator "It's you."
    narrator "Observations."
    narrator "Patterns."
    narrator "Written in his precise, structured handwriting."

    narrator "The last line."
    narrator "{i}Forgets I'm there when the answer is real. That's when se's actually here.{/i}"

    mc "..."

    mc "You were doing the same thing."

    orion "I was paying attention."
    orion "There's a difference."

    mc "What's the difference?"

    orion "I wasn't trying to stay useful."
    orion "I just wanted you to know."

    narrator "The library."
    narrator "6 PM light."
    narrator "Dust in the air."
    narrator "His notebook open between you."

    narrator "Rank 1."
    narrator "And for the first time, you're not sure it's the most important thing on the table."

    scene bg school_corridor
    with fade
    
    narrator "You walk out together."
    
    mc "I spent do long becoming impressive that I forgot how to become honest."

    orion "You're being honest now."

    mc "It took me a year."

    orion "Some people never get there."

    narrator "He's half a step ahead."
    narrator "Like always."
    narrator "Except this time, you don't measure the distance/"

    narrator "You already know it."
    narrator "You've always known it."
    narrator "You just stopped needing it to mean something."

    narrator "{b}— Ending 1: Perfect Answer —{/b}"
    narrator "{i}You became what they wanted. Then you found out what you wanted.{/i}"
    narrator "{i}It was the same thing. Just smaller. Just realer.{/i}"

    return

label ending_imperfect_but_real:

    scene bg classroom 
    with fade

    narrator "Pre-board results."
    narrator "8:47 AM."

    narrator "Rank 2."
    narrator "Your name."
    narrator "Second."
    narrator "Again."

    narrator "You stand there."
    narrator "And you wait for the familiar weight of it."
    narrator "The quiet shame."
    narrator "The recalculation."
    narrator "The immediate pivot to next time."

    narrator "It doesn't come."

    narrator "You just — stand there."
    narrator "And breathe."

    scene bg school_corridor
    with dissolve

    narrator "He finds you at your locker."

    orion "Rank 2."

    mc "Rank 2."

    orion "You didn't write it his way."

    narrator "He means question seven."
    narrator "You know exactly which question he means."
    narrator "You answered it your way."
    narrator "The shortcut."
    narrator "The intuitive leap."
    narrator "No structured steps."
    narrator "Just — the answer, arrived at the way your brain arrives at things."

    mc "No."

    orion "Why not?"

    mc "Because it wasn't how I think."
    mc "And I wanted to know if my way was actually wrong."
    mc "Or just different."

    narrator "He looks at you."

    orion "You lost two marks."

    mc "I know."

    orion "You could have had Rank 1."

    mc "I know."

    orion "Was it worth it?"

    narrator "You think about it."
    narrator "Actually think about it."
    narrator "Not the automatic answer."
    narrator "The real one."

    mc "Yes."

    narrator "He's quiet for a moment."

    orion "Your method was valid."
    orion "The examiner marked it wrong because it didn't follow convention."
    orion "That's not the same as being wrong."

    mc "I know."

    orion "I would have written it the structured way."

    mc "I know."

    orion "I think I've been writing things the structured way for so long I don't remember if I have another way."

    narrator "You look at him."
    narrator "He's looking at the floor."
    narrator "That's new."
    narrator "He always looks directly at things."

    mc "You could find out."

    orion "How?"

    mc "Stop writing the structured way for one problem."
    mc "See what comes out."

    narrator "He considers this."
    narrator "Seriously."
    narrator "The way he considers everything."

    orion "That sounds inefficient."

    mc "Most honest things are."

    narrator "He almost smiles."
    narrator "Almost."

    scene bg library
    with dissolve

    narrator "Last session of the year."
    narrator "Library table."
    narrator "His notes. Your questions."
    narrator "Except today neither of you has opened a textbook."

    orion "What will you do differently next year?"

    mc "Nothing."

    orion "Nothing?"

    mc "I'll keep doing it my way."
    mc "And I'll write the steps down properly so I don't lose marks for it."
    mc "But the thinking stays mine."

    orion "That's both things."

    mc "That's the point."

    narrator "He writes something."
    narrator "You don't try to read it."
    narrator "You've stopped trying to read it."
    narrator "Some things don't need to be decoded."

    orion "I've been thinking about what you said."
    orion "About not knowing if you like physics."

    mc "And?"

    orion "I think you do."
    orion "I think you like the part where something that seemed impossible suddenly makes sense."
    orion "You just don't like the part where you have to show your work."

    mc "Because showing your work means showing how you think."

    orion "Yes."

    mc "And showing how you think means being readable."

    orion "Yes."

    mc "And being readable means—"

    orion "Being known."

    narrator "The library."
    narrator "Quiet."
    narrator "Late afternoon light."

    mc "I don't love being known."

    orion "I know."

    mc "You know a lot of things about me."

    orion "You know a lot of things about me too."

    mc "That's different."

    orion "Is it?"

    narrator "You think about the notebook."
    narrator "Right side."
    narrator "Every observation."
    narrator "Every pattern."
    narrator "Every line."

    narrator "You think about his margin notes."
    narrator "The ones you still haven't read."

    mc "Maybe not."

    narrator "He slides his notebook across the table."
    narrator "Open to the margin."
    narrator "You read it."

    narrator "It's short."
    narrator "Three lines."

    narrator "{i}Answers before I finish asking.{/i}"
    narrator "{i}Thinks faster than she writes.{/i}"
    narrator "{i}Rank 2. But only because she's the only one honest enough to answer like herself.{/i}"

    narrator "You sit with that for a long time."

    mc "You think Rank 2 is honest?"

    orion "I think Rank 2 is yours."
    orion "Rank 1 would have been mine."

    mc "That's not a compliment."

    orion "No."
    orion "It's more than that."

    scene bg school_corridor
    with fade

    narrator "You walk out into the evening."
    narrator "He's beside you."
    narrator "Not half a step ahead."
    narrator "Beside."

    narrator "You notice."
    narrator "You don't say anything."
    narrator "You don't need to."

    narrator "{b}— Ending 2: Imperfect But Real —{/b}"
    narrator "{i}You stayed yourself.{/i}"
    narrator "{i}It cost you something.{/i}"
    narrator "{i}It was still worth it.{/i}"

    return


## ── Ending 3: Balanced (Best Ending) ────────────────────────

label ending_balanced:

    scene bg classroom
    with fade

    narrator "Pre-board results."
    narrator "8:47 AM."
    narrator "The list."

    narrator "You look at it."
    narrator "You read it once."
    narrator "Then you read it again."

    narrator "Rank 1: Orion Hale. 98.6"
    narrator "Rank 2: You. 98.6"

    narrator "..."

    narrator "Tied."

    narrator "You've never tied with anyone in your life."
    narrator "You've been first or second."
    narrator "Never equal."
    narrator "Never — the same."

    narrator "You stand there."
    narrator "And something you don't have a name for moves through you."
    narrator "Not relief."
    narrator "Not victory."
    narrator "Something quieter."
    narrator "Something that feels like — arriving."

    scene bg school_corridor
    with dissolve

    narrator "He's already seen it."
    narrator "Of course he has."
    narrator "He's standing at the end of the corridor."
    narrator "Waiting."
    narrator "You walk toward him."

    orion "0.0 difference."

    mc "0.0 difference."

    narrator "Neither of you says anything else for a moment."

    orion "You wrote the steps."

    mc "You left room for the intuitive leap."

    orion "Question nine."

    mc "I saw it."

    orion "I wasn't sure it would work."

    mc "It worked."

    narrator "He looks at the results board."
    narrator "Then at you."

    orion "I've never tied with anyone."

    mc "Neither have I."

    orion "How does it feel?"

    narrator "You think about it."
    narrator "The real answer."
    narrator "Not the performance."

    mc "Like the rank finally stopped being the point."

    narrator "He's quiet."
    narrator "Then:"

    orion "Yes."
    orion "Exactly that."

    scene bg library
    with dissolve

    narrator "Last session."
    narrator "Library table."
    narrator "Both notebooks open."
    narrator "Both sides."

    narrator "You put the right side of your notebook on the table."
    narrator "Face up."
    narrator "You don't say anything."
    narrator "You just — let it be there."

    narrator "He reads it."
    narrator "All of it."
    narrator "You watch him read it."
    narrator "You don't look away."
    narrator "You don't perform composure."
    narrator "You just sit there."
    narrator "And let him see it."

    orion "..."

    orion "You've been doing this the whole time."

    mc "Yes."

    orion "With everyone."

    mc "Yes."

    orion "Why are you showing me?"

    mc "Because you already knew."
    mc "You just didn't have proof."
    mc "And I'm tired of being the only one who knows what I am."

    narrator "He closes the notebook."
    narrator "He slides it back."
    narrator "He opens his own."
    narrator "The margin."

    narrator "He turns it toward you."

    narrator "You read it."

    narrator "It's longer than you expected."
    narrator "Weeks of observations."
    narrator "Patterns."
    narrator "Questions he never asked out loud."

    narrator "The last entry is recent."
    narrator "The ink is barely dry."

    narrator "{i}She showed me the notebook today.{/i}"
    narrator "{i}She knew I already knew.{/i}"
    narrator "{i}She showed me anyway.{/i}"
    narrator "{i}That's the bravest thing I've seen anyone do.{/i}"

    narrator "You look up."

    mc "You wrote that today."

    orion "I wrote it this morning."
    orion "Before you showed me."

    mc "How did you know I would?"

    orion "I didn't."
    orion "I just — hoped."

    narrator "The library."
    narrator "Quiet."
    narrator "Both notebooks open on a table."
    narrator "Both margins visible."
    narrator "Two people who spent a year paying attention to each other."
    narrator "Finally paying attention at the same time."

    mc "I don't know who I am when nobody's watching."

    orion "I know."

    mc "That doesn't bother you?"

    orion "You'd be figuring it out."
    orion "I'd rather be here while you do than not."

    narrator "You sit with that."
    narrator "You just let it be true."

    scene bg school_corridor
    with fade

    narrator "You walk out together."
    narrator "Evening."
    narrator "The corridor empty."
    narrator "Both of you quiet."

    narrator "At the door, he stops."

    orion "Same table?"

    narrator "He nods."
    narrator "Hw walks out."
    narrator "You follow."

    narrator "Not half a step behind."
    narrator "Beside him."

    narrator "{b}— Ending 3: Balanced —{/b}"
    narrator "{i}You learned his precision.{/i}"
    narrator "{i}He learned your honesty.{/i}"
    narrator "{i}0.0 difference.{/i}"
    narrator "{i}That's not a tie.{/i}"
    narrator "{i}That's the answer.{/i}"

    return